<Window x:Class="Froststrap.UI.Elements.Overlay.OverlayToast"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Froststrap Overlay Notification"
        Background="Transparent"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        FontFamily="{StaticResource Inter}"
        d:DesignWidth="400">

    <Border x:Name="Card"
            Width="364"
            Margin="16"
            Padding="16"
            CornerRadius="8"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              OffsetX="0" OffsetY="6"
                              Opacity="0.55"
                              Color="Black" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Image Source="avares://Froststrap/Froststrap.ico"
                       Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       VerticalAlignment="Center" />

                <TextBlock Text="Fishstrap"
                           FontSize="12"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="ToastTitle"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="ToastMessage"
                       FontSize="13"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
</Window>