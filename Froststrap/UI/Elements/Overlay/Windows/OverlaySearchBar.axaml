<Window x:Class="Froststrap.UI.Elements.Overlay.OverlaySearchBar"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="using:Froststrap.Resources"
        xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
        xmlns:overlay="clr-namespace:Froststrap.UI.Elements.Overlay.Controls"
        xmlns:tabs="clr-namespace:Froststrap.UI.Elements.Overlay.SearchTabs"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Overlay"
        xmlns:model="clr-namespace:Froststrap.Models.Overlay"
        x:DataType="vm:OverlaySearchBarViewModel"
        mc:Ignorable="d"
        Title="Froststrap Search"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        IsVisible="False"
        WindowStartupLocation="Manual"
        d:DesignWidth="1280"
        d:DesignHeight="720">

    <Window.Styles>
        <Style Selector="ListBox.searchResults">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.searchResults ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.searchResults ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="2,2,2,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox.searchResults ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="ListBox.searchResults ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        </Style>

        <Style Selector="ListBox.searchResults ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Border x:Name="Scrim"
            Background="#B3000000"
            PointerPressed="ScrimClicked">

        <Border Width="720"
                MaxHeight="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1">

            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="16,14,16,10">

                    <ic:Lucide Grid.Column="0"
                               Icon="Search"
                               Width="16" Height="16"
                               VerticalAlignment="Center"
                               StrokeBrush="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBox x:Name="SearchInput"
                             Grid.Column="1"
                             Classes="NoEffect"
                             Margin="10,0,10,0"
                             FontSize="15"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             PlaceholderText="{x:Static resources:Strings.Menu_Overlay_SearchBar_Placeholder}"
                             Text="{Binding Query, Mode=TwoWay}" />

                    <Border Grid.Column="2"
                            Padding="9,4"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Esc}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>

                <Panel Grid.Row="1" MinHeight="240">

                    <Border Margin="8,0,8,0"
                            CornerRadius="8"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            IsVisible="{Binding !ShowPrivateServers}">
                        <TabControl x:Name="Tabs"
                                    Padding="4,4,4,0"
                                    Background="Transparent"
                                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                            <TabControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </TabControl.ItemsPanel>

                            <TabControl.Styles>
                                <Style Selector="TabItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>

                                <Style Selector="TabItem.Square /template/ Border#PART_LayoutRoot">
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </TabControl.Styles>

                            <TabItem Classes="Square" Header="{x:Static resources:Strings.Menu_Overlay_SearchBar_Tab_Games}">
                                <ui:TabItemHelper.Icon>
                                    <ic:Lucide Icon="Gamepad2" />
                                </ui:TabItemHelper.Icon>

                                <Grid RowDefinitions="Auto,*">

                                    <TextBlock Grid.Row="0"
                                               Margin="20,6,20,2"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Continue}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               IsVisible="{Binding ShowContinueHeader}" />

                                    <ListBox x:Name="ResultList"
                                             Grid.Row="1"
                                             Classes="searchResults"
                                             Margin="8,6,8,0"
                                             ItemsSource="{Binding Results}"
                                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             DoubleTapped="ResultDoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="model:GameTile">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      Margin="8,6">

                                                    <Border Grid.Column="0"
                                                            Width="48" Height="48"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding IconBitmap}"
                                                               Width="48" Height="48"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="12,0,12,0"
                                                                VerticalAlignment="Center"
                                                                Spacing="3">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    IsVisible="{Binding HasCreator}">
                                                            <TextBlock Text="{Binding Creator, StringFormat='By {0}'}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <Image Source="avares://Froststrap/Resources/RobloxVerified.png"
                                                                   Width="12"
                                                                   Height="12"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                   IsVisible="{Binding IsVerified}" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        IsVisible="{Binding HasPlaying}">
                                                                <ic:Lucide Icon="Users"
                                                                           Width="11" Height="11"
                                                                           VerticalAlignment="Center"
                                                                           StrokeBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Text="{Binding Playing, Converter={StaticResource NumberAbbreviationConverter}}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Playing}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        IsVisible="{Binding HasLikeRatio}">
                                                                <ic:Lucide Icon="ThumbsUp"
                                                                           Width="11" Height="11"
                                                                           VerticalAlignment="Center"
                                                                           StrokeBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Text="{Binding LikeRatioText}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        IsVisible="{Binding HasFavorites}">
                                                                <ic:Lucide Icon="Star"
                                                                           Width="11" Height="11"
                                                                           VerticalAlignment="Center"
                                                                           StrokeBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <TextBlock Text="{Binding FavoritesText}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">

                                                        <controls:IconButton Width="36" Height="36"
                                                                             Padding="0"
                                                                             CornerRadius="10"
                                                                             IconSize="16"
                                                                             Icon="Lock"
                                                                             Command="{Binding $parent[ItemsControl].((vm:OverlaySearchBarViewModel)DataContext).OpenPrivateServersCommand}"
                                                                             CommandParameter="{Binding}"
                                                                             ToolTip.Tip="{x:Static resources:Strings.Menu_Overlay_PrivateServers_ConfigureTitle}" />

                                                        <controls:IconButton Width="36" Height="36"
                                                                             Padding="0"
                                                                             CornerRadius="10"
                                                                             IconSize="16"
                                                                             Icon="Earth"
                                                                             Command="{Binding $parent[ItemsControl].((vm:OverlaySearchBarViewModel)DataContext).JoinRegionCommand}"
                                                                             CommandParameter="{Binding}"
                                                                             IsVisible="{Binding IsRegionIdle}" />

                                                        <ui:FAProgressRing Width="32" Height="32"
                                                                           Margin="8,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                                           IsIndeterminate="True"
                                                                           IsActive="{Binding IsJoiningRegion}"
                                                                           IsVisible="{Binding IsJoiningRegion}" />

                                                        <controls:IconButton Width="36" Height="36"
                                                                             Padding="0"
                                                                             CornerRadius="10"
                                                                             IconSize="16"
                                                                             Icon="Play"
                                                                             IsFilled="True"
                                                                             Classes="Success"
                                                                             Command="{Binding $parent[ItemsControl].((vm:OverlaySearchBarViewModel)DataContext).JoinCommand}"
                                                                             CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <ui:FAProgressRing Grid.Row="1"
                                                       Width="28" Height="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsIndeterminate="True"
                                                       IsActive="{Binding IsGamesLoading}"
                                                       IsVisible="{Binding IsGamesLoading}"
                                                       Foreground="{DynamicResource SystemAccentColor}" />

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding EmptyText}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="24"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               IsVisible="{Binding ShowEmpty}" />
                                </Grid>
                            </TabItem>

                            <TabItem Classes="Square" Header="{x:Static resources:Strings.Menu_Overlay_SearchBar_Tab_People}">
                                <ui:TabItemHelper.Icon>
                                    <ic:Lucide Icon="Users" />
                                </ui:TabItemHelper.Icon>

                                <tabs:PeopleBrowser DataContext="{Binding People}" />
                            </TabItem>
                        </TabControl>
                    </Border>

                    <Border Padding="20,16,20,12"
                            IsVisible="{Binding ShowPrivateServers}">
                        <overlay:PrivateServerBrowser
                            DataContext="{Binding PrivateServers}" />
                    </Border>
                </Panel>

                <Border Grid.Row="2"
                        Padding="16,8"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Padding="9,4"
                                        MinWidth="32"
                                        CornerRadius="4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <ic:Lucide Icon="ArrowUp"
                                               Width="12" Height="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               StrokeThickness="2"
                                               StrokeBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Padding="9,4"
                                        MinWidth="32"
                                        CornerRadius="4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <ic:Lucide Icon="ArrowDown"
                                               Width="12" Height="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               StrokeThickness="2"
                                               StrokeBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Navigate}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Padding="9,4"
                                    MinWidth="32"
                                    CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ic:Lucide Icon="CornerDownLeft"
                                           Width="12" Height="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           StrokeThickness="2"
                                           StrokeBrush="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Join}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
