<UserControl
    x:Class="Froststrap.UI.Elements.Overlay.Controls.GameBrowser"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Overlay.Controls"
    d:DesignHeight="520"
    d:DesignWidth="720"
    x:CompileBindings="False"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="RadioButton.tabToggle">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tabToggle:pointerover /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="RadioButton.tabToggle:checked /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style Selector="RadioButton.tabToggle:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="Button.gameTileButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Bd"
                        Padding="6"
                        Background="Transparent"
                        CornerRadius="8">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.gameTileButton:pointerover /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gameTileButton:pressed /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>

        <Style Selector="Button.gameTileButton Border.playBadge">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.gameTileButton:pointerover Border.playBadge">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button.gameTileButton Image.gameIcon">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.gameTileButton:pointerover Image.gameIcon">
            <Setter Property="Effect">
                <BlurEffect Radius="12" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <Grid
            Grid.Row="0"
            Margin="0,0,0,8"
            ColumnDefinitions="Auto,*">

            <Border
                Grid.Column="0"
                Padding="3"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Classes="tabToggle"
                        GroupName="GameBrowserTab"
                        IsChecked="{Binding ShowingSearch, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ic:Lucide
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Icon="Search"
                                StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{x:Static resources:Strings.Menu_Overlay_Games_Search}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        Margin="2,0,0,0"
                        Classes="tabToggle"
                        GroupName="GameBrowserTab"
                        IsChecked="{Binding ShowingFavorites, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ic:Lucide
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Icon="Star"
                                StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{x:Static resources:Strings.Menu_Overlay_Games_Favorites}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <TextBox
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                IsVisible="{Binding ShowingSearch}"
                PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Games_SearchPlaceholder}"
                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="2,0,0,8"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            IsVisible="{Binding HasStatus}"
            Text="{Binding StatusText}" />

        <TextBlock
            Grid.Row="2"
            Margin="2,0,0,8"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            IsVisible="{Binding ShowContinueLabel}"
            Text="{x:Static resources:Strings.Menu_Overlay_Games_Continue}" />

        <Grid Grid.Row="3">
            <ui:FAProgressRing
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                IsVisible="{Binding IsBusy}" />

            <TextBlock
                MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                IsVisible="{Binding ShowEmptyState}"
                Text="{Binding EmptyText}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ScrollViewer
                Margin="0,0,-8,0"
                Padding="0,0,8,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ActiveTiles}" Margin="-4,-4,-4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:UniformWrapPanel MinItemWidth="148" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="4"
                                Classes="gameTileButton"
                                Command="{Binding $parent[ItemsControl].((vm:GameBrowserViewModel)DataContext).JoinCommand}"
                                CommandParameter="{Binding Mode=OneTime}"
                                ToolTip.Tip="{Binding Name}">
                                <StackPanel>
                                    <Grid Height="136">
                                        <Border
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="8">
                                            <Image
                                                Classes="gameIcon"
                                                RenderOptions.BitmapInterpolationMode="LowQuality"
                                                Source="{Binding IconBitmap}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <Border
                                            Width="44"
                                            Height="44"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Classes="playBadge"
                                            CornerRadius="22">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="12"
                                                    OffsetX="0"
                                                    OffsetY="2"
                                                    Opacity="0.5"
                                                    Color="Black" />
                                            </Border.Effect>
                                            <ic:Lucide
                                                Width="20"
                                                Height="20"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Icon="Play"
                                                StrokeBrush="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock
                                        MaxHeight="36"
                                        Margin="0,6,0,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding PlayingText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>