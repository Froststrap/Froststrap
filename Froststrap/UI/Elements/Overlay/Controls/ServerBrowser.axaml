<UserControl
    x:Class="Froststrap.UI.Elements.Overlay.Controls.ServerBrowser"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Froststrap.UI.Elements.Overlay.Controls"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Froststrap.Models.Overlay"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Overlay.Controls"
    xmlns:vms="clr-namespace:Froststrap.UI.ViewModels"
    d:DesignHeight="560"
    d:DesignWidth="820"
    x:DataType="vm:ServerBrowserViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="RadioButton.TabToggle">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.TabToggle:pointerover /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="RadioButton.TabToggle:checked /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style Selector="RadioButton.TabToggle:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.StatText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="Button.cardAction">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.creditLink">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Bd"
                        Padding="8,4"
                        Background="Transparent"
                        CornerRadius="6">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.creditLink:pointerover /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="3"
            HorizontalAlignment="Left"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    x:Name="PublicTab"
                    Classes="TabToggle"
                    GroupName="ServerTab"
                    IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <ic:Lucide
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Icon="Cloud" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{x:Static resources:Strings.Menu_Overlay_Servers_PublicTab}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="PrivateTab"
                    Margin="2,0,0,0"
                    Classes="TabToggle"
                    GroupName="ServerTab">
                    <StackPanel Orientation="Horizontal">
                        <ic:Lucide
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Icon="Lock" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{x:Static resources:Strings.Menu_Overlay_Servers_PrivateTab}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <control:PrivateServerBrowser
            x:Name="PrivateView"
            Grid.Row="1"
            IsVisible="{Binding #PrivateTab.IsChecked}" />

        <Grid
            x:Name="PublicView"
            Grid.Row="1"
            IsVisible="{Binding #PublicTab.IsChecked}"
            RowDefinitions="Auto,Auto,*">

            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasCurrentServer}">
                <Grid ColumnDefinitions="Auto,3*,Auto,2*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Type}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding CurrentServerType}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,6,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{x:Static resources:Strings.ContextMenu_ServerInformation_InstanceId}" />
                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Left"
                        ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding CurrentJobId}"
                            TextTrimming="CharacterEllipsis" />
                        <controls:IconButton
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Command="{Binding CopyInstanceIdCommand}"
                            CommandParameter="{Binding $self}"
                            Icon="Copy"
                            IconSize="12"
                            ToolTip.Tip="{x:Static resources:Strings.ContextMenu_ServerInformation_CopyInstanceId}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="20,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        IsVisible="{Binding ShowCurrentLocation}"
                        Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Location}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        IsVisible="{Binding ShowCurrentLocation}"
                        Text="{Binding CurrentLocation}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="20,6,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Uptime}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,6,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding CurrentUptime}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <controls:IconButton
                            Margin="0,0,8,0"
                            Command="{Binding ClosestCommand}"
                            Content="{x:Static resources:Strings.Menu_Overlay_Servers_Closest}"
                            Icon="MapPin"
                            IsEnabled="{Binding CanJoinClosest}"
                            ToolTip.Tip="{x:Static resources:Strings.Menu_Overlay_Servers_ClosestTooltip}" />

                        <controls:IconButton
                            Classes="Primary"
                            Command="{Binding HopCommand}"
                            Content="{x:Static resources:Strings.Menu_Overlay_Servers_Hop}"
                            Icon="Shuffle"
                            IsEnabled="{Binding CanHop}"
                            ToolTip.Tip="{x:Static resources:Strings.Menu_Overlay_Servers_HopTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,6"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel
                            Margin="0,3,20,3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Strings.Menu_Overlay_Servers_SortByPlayers}" />
                            <ComboBox
                                MinWidth="140"
                                Margin="10,0,0,0"
                                ItemsSource="{Binding Orders, Mode=OneTime}"
                                SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel
                            Margin="0,3,20,3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Strings.Menu_Overlay_Servers_Region}" />
                            <ComboBox
                                MinWidth="150"
                                Margin="10,0,0,0"
                                ItemsSource="{Binding Regions}"
                                MaxDropDownHeight="280"
                                SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,3,0,3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding ExcludeFull, Mode=TwoWay}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static resources:Strings.Menu_Overlay_Servers_HideFull}" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SummaryText}" />

                    <controls:IconButton
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Icon="RefreshCw"
                        IconSize="14"
                        IsEnabled="{Binding CanRefresh}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ui:FAProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsBusy}" />

                <TextBlock
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsVisible="{Binding ShowEmptyState}"
                    Text="{Binding EmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Margin="0,0,-8,0"
                    Padding="0,0,8,0"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="-4,-4,-4,0" ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:UniformWrapPanel MinItemWidth="230" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameServer">
                                <Border
                                    Margin="4"
                                    Padding="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                                        <ItemsControl
                                            Grid.Row="0"
                                            Height="124"
                                            ItemsSource="{Binding Avatars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" Rows="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ServerAvatar">
                                                    <Grid Width="56" Height="56">
                                                        <Border
                                                            x:Name="Backing"
                                                            Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                                                            CornerRadius="28" />
                                                        <Border
                                                            x:Name="Face"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            ClipToBounds="True"
                                                            CornerRadius="28">
                                                            <Image
                                                                RenderOptions.BitmapInterpolationMode="LowQuality"
                                                                Source="{Binding ImageBitmap}"
                                                                Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock
                                                            x:Name="More"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            IsVisible="{Binding IsOverflow}"
                                                            Text="{Binding OverflowText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,10,0,8"
                                            FontSize="15"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding CapacityText}"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Row="2">
                                            <StackPanel
                                                Margin="0,0,0,6"
                                                IsVisible="{Binding HasPerformance}"
                                                Orientation="Horizontal">
                                                <ic:Lucide
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Icon="TrendingUp" />
                                                <TextBlock Classes="StatText" Text="{Binding PerformanceText}" />
                                            </StackPanel>
                                            <StackPanel
                                                Margin="0,0,0,6"
                                                IsVisible="{Binding HasUptime}"
                                                Orientation="Horizontal">
                                                <ic:Lucide
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Icon="Clock" />
                                                <TextBlock Classes="StatText" Text="{Binding UptimeText}" />
                                            </StackPanel>
                                            <StackPanel
                                                Margin="0,0,0,6"
                                                IsVisible="{Binding HasVersion}"
                                                Orientation="Horizontal">
                                                <ic:Lucide
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Icon="Activity" />
                                                <TextBlock Classes="StatText" Text="{Binding VersionText}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3">
                                            <ProgressBar
                                                Height="4"
                                                Margin="0,4,0,12"
                                                Maximum="100"
                                                Value="{Binding FillPercentage, Mode=OneWay}" />

                                            <Button
                                                x:Name="JoinButton"
                                                Classes="cardAction"
                                                Command="{Binding $parent[ItemsControl].((vm:ServerBrowserViewModel)DataContext).JoinCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static resources:Strings.Menu_Overlay_Servers_Join}" />

                                            <Button
                                                Margin="0,6,0,0"
                                                Classes="cardAction"
                                                Command="{Binding $parent[ItemsControl].((vm:ServerBrowserViewModel)DataContext).CopyLinkCommand}"
                                                CommandParameter="{Binding $self}"
                                                Content="{x:Static resources:Strings.Menu_Overlay_Servers_Share}"
                                                ToolTip.Tip="{x:Static resources:Strings.Menu_Overlay_Servers_CopyLink}" />

                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding IdText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Button
            Grid.Row="2"
            Margin="0,6,0,0"
            HorizontalAlignment="Right"
            Classes="creditLink"
            Command="{x:Static vms:GlobalViewModel.OpenWebpageCommand}"
            CommandParameter="https://www.rovalra.com/"
            ToolTip.Tip="{x:Static resources:Strings.Menu_Overlay_Servers_CreditTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{x:Static resources:Strings.Menu_Overlay_Servers_Credit}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                    Text="RoValra" />
                <ic:Lucide
                    Width="11"
                    Height="11"
                    VerticalAlignment="Center"
                    Icon="ExternalLink"
                    StrokeBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>