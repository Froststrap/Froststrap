<UserControl x:Class="Froststrap.UI.Elements.Overlay.Controls.JoinByLink"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:control="clr-namespace:Froststrap.UI.Elements.Overlay.Controls"
             xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Overlay"
             x:DataType="vm:GameOverlayViewModel"
             mc:Ignorable="d"
             d:DesignHeight="56" d:DesignWidth="700"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.linkButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsHitTestVisible" Value="{Binding !JoinByLink.IsOpen}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Bd"
                            Background="Transparent"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.linkButton:pointerover /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.linkButton:pressed /template/ Border#PART_Bd">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal">

        <Button Name="LinkButton"
                Classes="linkButton"
                Command="{Binding JoinByLink.OpenCommand}"
                control:DockHintLayer.Text="{x:Static resources:Strings.Menu_Overlay_JoinByLink_Title}">
            <ic:Lucide Icon="Link2"
                       Width="16" Height="16"
                       StrokeBrush="{DynamicResource TextFillColorSecondaryBrush}" />
        </Button>

        <Popup Name="LinkPopup"
               IsOpen="{Binding JoinByLink.IsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #LinkButton}"
               Placement="Top"
               VerticalOffset="-6"
               HorizontalOffset="0"
               IsLightDismissEnabled="True"
               Opened="LinkPopup_Opened">
            <Border Width="360"
                    Margin="12"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">


                    <Border Padding="10"
                            CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding JoinByLink.HasGame}">
                        <Grid ColumnDefinitions="Auto,*">

                            <Border Width="56" Height="56"
                                    CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    ClipToBounds="True">
                                <Image Source="{Binding JoinByLink.GameBitmap}"
                                       Width="56" Height="56"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                <TextBlock Text="{Binding JoinByLink.GameName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            IsVisible="{Binding JoinByLink.HasCreator}">
                                    <TextBlock Text="{Binding JoinByLink.GameCreator, StringFormat='By {0}'}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image Source="avares://Froststrap/Resources/RobloxVerified.png"
                                           Width="12" Height="12"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           IsVisible="{Binding JoinByLink.IsVerified}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            IsVisible="{Binding JoinByLink.HasPlaying}">
                                    <ic:Lucide Icon="Users"
                                               Width="11" Height="11"
                                               VerticalAlignment="Center"
                                               StrokeBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding JoinByLink.Playing, Converter={StaticResource NumberAbbreviationConverter}}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_SearchBar_Playing}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_JoinByLink_Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBox x:Name="LinkBox"
                             Text="{Binding JoinByLink.Link, Mode=TwoWay}"
                             PlaceholderText="{x:Static resources:Strings.Menu_Overlay_JoinByLink_Placeholder}"
                             KeyDown="LinkBox_KeyDown" />

                    <TextBlock Text="{Binding JoinByLink.Status}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding JoinByLink.HasStatus}" />

                    <controls:IconButton Classes="Primary"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Icon="LogIn"
                                         Content="{x:Static resources:Strings.Menu_Overlay_JoinByLink_Join}"
                                         Command="{Binding JoinByLink.JoinCommand}" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
