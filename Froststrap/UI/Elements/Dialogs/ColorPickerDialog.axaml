<base:AvaloniaWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Froststrap.UI.Elements.Dialogs.ColorPickerDialog"
    xmlns:base="using:Froststrap.UI.Elements.Base"
    xmlns:resources="using:Froststrap.Localisation"
    Title="{x:Static resources:Strings.Common_ColorPicker}"
    Width="420"
    Height="560"
    CanResize="False"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ColorView x:Name="Part_ColorView"
                   Grid.Row="0"
                   Margin="20,20,20,10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   IsAlphaEnabled="False"
                   IsAlphaVisible="False" />

        <Border Grid.Row="1" Padding="15" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="{x:Static resources:Strings.Common_Confirm}"
                        Width="100"
                        Click="OnConfirm_Click"
                        Classes="accent" />
                <Button Content="{x:Static resources:Strings.Common_Cancel}"
                        Width="100"
                        Click="OnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</base:AvaloniaWindow>
