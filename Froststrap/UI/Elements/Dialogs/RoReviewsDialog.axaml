<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.RoReviewsDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
                     xmlns:resources="clr-namespace:Froststrap.Resources"
                     xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     xmlns:ui="using:FluentAvalonia.UI.Controls"
                     x:Name="RootDialog"
                     x:DataType="vm:RoReviewsViewModel"
                     Title="{Binding GameName}"
                     Width="760"
                     Height="700"
                     MinWidth="560"
                     MinHeight="480"
                     WindowStartupLocation="CenterOwner"
                     ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="16" Background="#33000000">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_QuickPlay_Reviews}" Opacity="0.65" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static resources:Strings.RoReviews_SignOut}"
                            Command="{Binding SignOutCommand}"
                            Padding="10,5"
                            IsVisible="{Binding IsAuthenticated}" />
                    <Button Click="CloseClicked" Background="Transparent" BorderThickness="0">
                        <ic:Lucide Icon="X" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="16">
            <Grid>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Reviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoReviewItemViewModel">
                                <Border Padding="12" Margin="0,0,0,8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding AvatarUrl, Converter={StaticResource UrlToBitmapConverter}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Opacity="0.55" FontSize="11" />
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Static resources:Strings.RoReviews_Edited}"
                                                   IsVisible="{Binding IsEdited}" Opacity="0.55" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Command="{Binding UpvoteCommand}"
                                                    IsEnabled="{Binding #RootDialog.DataContext.IsAuthenticated}"
                                                    Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:Lucide Icon="ThumbsUp" Width="13" Height="13" />
                                                    <TextBlock Text="{Binding Upvotes}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DownvoteCommand}"
                                                    IsEnabled="{Binding #RootDialog.DataContext.IsAuthenticated}"
                                                    Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:Lucide Icon="ThumbsDown" Width="13" Height="13" />
                                                    <TextBlock Text="{Binding Downvotes}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="20,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RoReviewItemViewModel">
                                                    <Border Padding="8" Margin="0,4,0,0"
                                                            Background="#22000000" CornerRadius="6">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <Border Width="26" Height="26" CornerRadius="13"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                    ClipToBounds="True"
                                                                    VerticalAlignment="Top">
                                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource UrlToBitmapConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            </Border>
                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Opacity="0.55" FontSize="10" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" FontSize="12" />
                                                            <TextBlock Text="{x:Static resources:Strings.RoReviews_Edited}"
                                                                       IsVisible="{Binding IsEdited}" Opacity="0.55" FontSize="10" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button Command="{Binding UpvoteCommand}"
                                                                        IsEnabled="{Binding #RootDialog.DataContext.IsAuthenticated}"
                                                                        Padding="6,2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <ic:Lucide Icon="ThumbsUp" Width="12" Height="12" />
                                                                        <TextBlock Text="{Binding Upvotes}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding DownvoteCommand}"
                                                                        IsEnabled="{Binding #RootDialog.DataContext.IsAuthenticated}"
                                                                        Padding="6,2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <ic:Lucide Icon="ThumbsDown" Width="12" Height="12" />
                                                                        <TextBlock Text="{Binding Downvotes}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ui:FAProgressRing IsVisible="{Binding IsLoading}" IsActive="{Binding IsLoading}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Width="40" Height="40" />
            </Grid>

            <Grid Grid.Row="1" IsVisible="{Binding IsAuthenticated}" Margin="0,12,0,0">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <Grid RowDefinitions="*,Auto">
                        <TextBox Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="52"
                                 MaxLength="8000"
                                 PlaceholderText="{x:Static resources:Strings.RoReviews_InputWatermark}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 KeyDown="DraftKeyDown" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CharacterCount, StringFormat='{}{0}/8000'}"
                                   FontSize="10"
                                   Opacity="0.6"
                                   Margin="2,4,0,0" />
                        <Button Grid.Row="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding SubmitCommand}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Classes="accent"
                                ToolTip.Tip="{x:Static resources:Strings.RoReviews_Submit}">
                            <ic:Lucide Icon="ArrowRight" Width="16" Height="16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <Button Grid.Row="1"
                    IsVisible="{Binding !IsAuthenticated}"
                    Content="{x:Static resources:Strings.RoReviews_AuthorizeToSend}"
                    Command="{Binding AuthorizeCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0" />
        </Grid>

        <Border Grid.Row="2" Padding="12" Background="#33000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static resources:Strings.RoReviews_PoweredBy}" />
                <Button Content="{x:Static resources:Strings.RoReviews_Name}"
                        Click="RoReviewLinkClicked"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</base:AvaloniaWindow>
