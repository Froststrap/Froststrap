<base:AvaloniaWindow
    x:Class="Froststrap.UI.Elements.Dialogs.SubplaceJoinDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:models="clr-namespace:Froststrap.Models"
    xmlns:dialogsVm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
    xmlns:resources="clr-namespace:Froststrap.Resources"
    x:Name="RootDialog"
    x:DataType="dialogsVm:SubplaceJoinDialogViewModel"
    Title="{x:Static resources:Strings.Menu_QuickPlay_AvailableSubplaces}"
    Width="700"
    Height="550"
    MinWidth="500"
    MinHeight="400"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    CanResize="True"
    ShowInTaskbar="False">

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="Transparent"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="#33000000"
                    Padding="16"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ic:Lucide Icon="Layers" Height="18" Width="18" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_QuickPlay_AvailableSubplaces}"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnCloseClicked"
                            Background="Transparent" BorderThickness="0">
                        <ic:Lucide Icon="X" Height="16" Width="16" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid IsVisible="{Binding IsLoading}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:FAProgressRing IsActive="{Binding IsLoading}" Width="40" Height="40"
                                           Foreground="{DynamicResource SystemAccentColor}"/>
                        <TextBlock Text="{x:Static resources:Strings.Menu_QuickPlay_LoadingSubplaces}"
                                   FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer IsVisible="{Binding !IsLoading}"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Subplaces}" Padding="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaceInfo">
                                <controls:Card Width="150" Margin="5" Padding="0" CornerRadius="8" ClipToBounds="True">
                                    <StackPanel>
                                        <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToBitmapConverter}}"
                                                   Height="150" Width="150" Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="LowQuality"/>
                                        </Border>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"/>
                                            <controls:IconButton
                                                Command="{Binding #RootDialog.DataContext.JoinSubplaceCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                Margin="4,0,4,4"
                                                Classes="Primary" Icon="Play"/>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</base:AvaloniaWindow>