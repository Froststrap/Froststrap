<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.AccountTransferDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:resources="clr-namespace:Froststrap.Resources"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs"
                     x:DataType="vm:AccountTransferDialogViewModel"
                     Width="460"
                     SizeToContent="Height"
                     CanResize="False"
                     WindowStartupLocation="CenterOwner"
                     mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="20,8,20,16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:Lucide FontSize="20" Icon="LockKeyhole" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
            </StackPanel>

            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />

            <Border IsVisible="{Binding IsExport}"
                    Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectableAccount">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBox PasswordChar="●"
                     Classes="revealPasswordButton"
                     Watermark="{x:Static resources:Strings.Menu_AccountTransfer_Password}"
                     Text="{Binding Password}"
                     IsEnabled="{Binding IsIdle}" />

            <TextBox IsVisible="{Binding IsExport}"
                     PasswordChar="●"
                     Classes="revealPasswordButton"
                     Watermark="{x:Static resources:Strings.Menu_AccountTransfer_ConfirmPassword}"
                     Text="{Binding ConfirmPassword}"
                     IsEnabled="{Binding IsIdle}" />

            <Border IsVisible="{Binding IsExport}"
                    Padding="12,8"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:Lucide Icon="TriangleAlert" FontSize="16" VerticalAlignment="Top" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_AccountTransfer_Export_Warning}"
                               TextWrapping="Wrap"
                               MaxWidth="370" />
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding HasError}"
                       Text="{Binding Error}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,16" ColumnDefinitions="*,Auto,Auto">
                <ProgressBar Grid.Column="0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Classes="accent"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        IsEnabled="{Binding IsIdle}" />

                <Button Grid.Column="2"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        IsEnabled="{Binding IsIdle}" />
            </Grid>
        </Border>
    </Grid>
</base:AvaloniaWindow>
