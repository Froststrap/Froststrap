<Window
    x:Class="Froststrap.UI.Elements.ContextMenu.MenuContainer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Froststrap"
    xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
    xmlns:resources="clr-namespace:Froststrap.Resources"
    Title="ContextMenuContainer"
    Width="0" Height="0"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Opacity="0" xmlns:local="clr-namespace:Froststrap.Localisation;assembly=Froststrap" xmlns:loc="clr-namespace:Froststrap.Localisation;assembly=Froststrap">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static app:App.ProjectName} {x:Static app:App.Version}" IsEnabled="False" />
            <NativeMenuItem Header="Total: 00:00" IsEnabled="False" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{local:LocalString Key=Common_DiscordRichPresence}" IsVisible="False" Click="RichPresenceMenuItem_Click" ToggleType="CheckBox" IsChecked="True" />
            <NativeMenuItem Header="{local:LocalString Key=Menu_Bootstrapper_SoftKey_Title}" IsVisible="False" Click="SoftkeyMenuItem_Click" ToggleType="CheckBox" IsChecked="True" />
            <NativeMenuItem Header="{local:LocalString Key=ContextMenu_CopyDeeplinkInvite}" IsVisible="False" Click="InviteDeeplinkMenuItem_Click" />
            <NativeMenuItem Header="{local:LocalString Key=Menu_ContextMenu_RegionJoin}" IsVisible="False" Click="AutoJoinRegionMenuItem_Click"/>
            <NativeMenuItem Header="{local:LocalString Key=ContextMenu_ServerInformation_Title}" IsVisible="False" Click="ServerDetailsMenuItem_Click" />
            <NativeMenuItem Header="{local:LocalString Key=ContextMenu_GameHistory_Title}" Click="JoinLastServerMenuItem_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{local:LocalString Key=ContextMenu_CloseRoblox}" Click="CloseRobloxMenuItem_Click" />
            <NativeMenuItem Header="{local:LocalString Key=Menu_ContextMenu_CloseWatcher}" Click="CloseWatcheMenuItem_Click" />
        </NativeMenu>
    </NativeMenu.Menu>
</Window>
