<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Froststrap.UI.ViewModels"
             xmlns:dmodels="using:Froststrap.UI.ViewModels.About"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:resources="using:Froststrap.Localisation"
             xmlns:utility="using:Froststrap.UI.Utility"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             x:DataType="dmodels:AboutViewModel"
             x:Class="Froststrap.UI.Elements.About.Pages.AboutPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <Grid Margin="0,24" HorizontalAlignment="Center" ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" x:Name="Image" Width="76" Height="76" VerticalAlignment="Center"
                       Source="avares://Froststrap/Resources/IconFroststrap.png" RenderOptions.BitmapInterpolationMode="HighQuality" />

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Froststrap" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_About_Description}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"  />
                </StackPanel>
            </Grid>

            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <controls:IconButton
                    Icon="SquareArrowOutUpRight"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    IconSize="18"
                    Margin="0,0,8,0"
                    Content="{x:Static resources:Strings.Menu_About_GithubRepository}"
                    Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                    CommandParameter="https://github.com/Froststrap/Froststrap" />

                <controls:IconButton
                    Icon="CircleQuestionMark"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    IconSize="18"
                    Margin="0,0,8,0"
                    Content="{x:Static resources:Strings.Menu_About_HelpInformation}"
                    Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                    CommandParameter="https://bloxstraplabs.com/wiki/" />

                <controls:IconButton
                    Icon="Flag"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    IconSize="18"
                    Margin="0,0,8,0"
                    Content="{x:Static resources:Strings.Menu_About_ReportIssue}"
                    Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                    CommandParameter="https://github.com/Froststrap/Froststrap/issues" />

                <controls:IconButton
                    Icon="Users"
                    VerticalAlignment="Center"
                    Padding="14,8"
                    IconSize="18"
                    Margin="0,0,8,0"
                    Content="{x:Static resources:Strings.Menu_About_DiscordServer}"
                    Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                    CommandParameter="https://discord.gg/KdR9vpRcUN" />
            </WrapPanel>

            <StackPanel>
                <TextBlock Text="{x:Static resources:Strings.Menu_About_BuildInfo}" FontWeight="Bold" FontSize="20" Margin="0,16,0,0" />

                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="{x:Static resources:Strings.Common_Timestamp}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding BuildTimestamp}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,16,4" FontSize="14" Text="{x:Static resources:Strings.Common_Version}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding Version}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{x:Static resources:Strings.Menu_About_Contributors}" FontWeight="Bold" FontSize="20" Margin="0,16,0,0" />

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_About_Contributors_Code}"
                Description="{x:Static resources:Strings.Menu_About_Contributors_Code_Description}"
                Margin="0,4,0,0"
                IsExpanded="True"
            >
                <ItemsControl ItemsSource="{Binding CodeContributors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dmodels:ContributorItem">
                            <controls:Card Margin="4" Padding="0" CornerRadius="12,12,4,4" ClipToBounds="True">
                                <StackPanel>
                                    <Border Margin="8,8,8,0" CornerRadius="8" ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Viewbox Stretch="Uniform">
                                            <Panel Width="100" Height="100">
                                                <ic:Lucide
                                                    Icon="User"
                                                    Width="40"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                                <Image
                                                    utility:RemoteImage.SourceUrl="{Binding AvatarUrl}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Panel>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Margin="8" Spacing="8">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <controls:IconButton
                                            Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                                            CommandParameter="{Binding Url}"
                                            Icon="Link"
                                            IconSize="14"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Classes="Primary"
                                            ToolTip.Tip="{Binding Url}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:CardExpander>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_About_Contributors}"
                Description="{x:Static resources:Strings.Menu_About_Contributors_Description}"
            >
                <StackPanel>
                    <controls:MarkdownTextBlock MarkdownText="[Efaz](https://github.com/EfazDev)" />
                    <controls:MarkdownTextBlock MarkdownText="[Valra](https://github.com/NotValra)" />
                    <controls:MarkdownTextBlock MarkdownText="[Bloxxy](https://github.com/ItzBloxxy)" />
                    <controls:MarkdownTextBlock MarkdownText="[jokoyanto987](https://github.com/jokoyanto987)" />
                    <controls:MarkdownTextBlock MarkdownText="[Scroom](https://discord.com/users/1254472513199673347)" />
                    <controls:MarkdownTextBlock MarkdownText="[MattDinio](https://discord.com/users/1353528667245903892)" />
                    <controls:MarkdownTextBlock MarkdownText="[Stoof](https://discord.com/users/1020107535589593138)" />
                    <controls:MarkdownTextBlock MarkdownText="[5070](https://discord.com/users/1272494435690610800)" />
                    <controls:MarkdownTextBlock MarkdownText="[Onion](https://discord.com/users/1104189426374033519)" />
                    <controls:MarkdownTextBlock MarkdownText="[Reslav](https://discord.com/users/1136966783027380256)" />
                    <controls:MarkdownTextBlock MarkdownText="[polover](https://discord.com/users/999142457667227679)" />
                    <controls:MarkdownTextBlock MarkdownText="[iniforce](https://discord.com/users/1029770533476257792)" />
                    <controls:MarkdownTextBlock MarkdownText="[Cak](https://discord.com/users/1136265435818508408)" />
                    <controls:MarkdownTextBlock MarkdownText="[Flemish](https://discord.com/users/1286961047990702124)" />
                    <controls:MarkdownTextBlock MarkdownText="[Noby](https://discord.com/users/1304922060882972732)" />
                    <controls:MarkdownTextBlock MarkdownText="[Obsurd](https://discord.com/users/818680236963135498)" />
                    <controls:MarkdownTextBlock MarkdownText="[SunGod (Polaris)](https://www.roblox.com/users/1484207733/profile)" />
                </StackPanel>
            </controls:CardExpander>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_About_Contributors_Insipirations}"
                Description="{x:Static resources:Strings.Menu_About_Contributors_Insipirations_Description}"
            >
                <StackPanel>
                    <controls:MarkdownTextBlock MarkdownText="[Bloxstrap](https://github.com/bloxstraplabs/bloxstrap)" />
                    <controls:MarkdownTextBlock MarkdownText="[Fishstrap](https://github.com/fishstrap/fishstrap)" />
                    <controls:MarkdownTextBlock MarkdownText="[AppleBlox](https://github.com/AppleBlox/appleblox)" />
                    <controls:MarkdownTextBlock MarkdownText="[Sober/Vinegar](https://github.com/vinegarhq/vinegar)" />
                    <controls:MarkdownTextBlock MarkdownText="[MaximumADHD](https://github.com/MaximumADHD)" />
                </StackPanel>
            </controls:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
