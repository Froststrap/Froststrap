<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:Froststrap.UI.Elements.Controls"
             xmlns:models="using:Froststrap.UI.ViewModels"
             xmlns:dmodels="using:Froststrap.UI.ViewModels.About"
             xmlns:resources="using:Froststrap.Localisation"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1500"
             x:DataType="dmodels:LicensesViewModel"
             x:Class="Froststrap.UI.Elements.About.Pages.LicensesPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Margin="0,0,0,4"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="{x:Static resources:Strings.About_Licenses_Title}" />

            <ItemsControl ItemsSource="{Binding Licenses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dmodels:LicenseItem">
                        <ui:CardAction Margin="4,2" Icon="Copyright"
                                       Header="{Binding Header}"
                                       Description="{Binding Description}"
                                       Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}"
                                       CommandParameter="{Binding Url}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
