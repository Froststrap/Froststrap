<UserControl
    x:Class="Froststrap.UI.Elements.Settings.Pages.RegionSelectorPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Froststrap.Localisation"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:models="clr-namespace:Froststrap.Models"
    xmlns:apis="clr-namespace:Froststrap.Models.APIs.Roblox"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    x:DataType="vm:RegionSelectorViewModel">

    <Grid Margin="14" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" CornerRadius="8">
            <StackPanel Spacing="8">
                <AutoCompleteBox
                    x:Name="GameSearchAutoCompleteBox"
                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding SearchResults}"
                    IsDropDownOpen="{Binding IsSearchFlyoutOpen, Mode=TwoWay}"
                    PlaceholderText="{x:Static resources:Strings.Menu_RegionSelector_FindGame}"
                    FilterMode="None"
                    Width="300"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate DataType="apis:OmniSearchContent">
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="8"
                                MaxWidth="270">
                                <Border
                                    Grid.Column="0"
                                    Width="44"
                                    Height="44"
                                    Background="#10FFFFFF"
                                    ClipToBounds="True"
                                    CornerRadius="4">
                                    <Image
                                        Source="{Binding ThumbnailBitmap}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding RootPlaceId, StringFormat='ID: {0}'}"
                                        FontSize="11"
                                        Opacity="0.5" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <ic:Lucide
                                        Icon="Users"
                                        Width="12"
                                        Height="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding PlayerCount, Converter={StaticResource NumberAbbreviationConverter}}"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>

                    <AutoCompleteBox.InnerLeftContent>
                        <ic:Lucide
                            Icon="Search"
                            Width="14"
                            Height="14"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </AutoCompleteBox.InnerLeftContent>

                    <AutoCompleteBox.InnerRightContent>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ui:FAProgressRing
                                IsVisible="{Binding IsGameSearchLoading}"
                                IsIndeterminate="True"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center" />
                            <controls:IconButton
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                Icon="X"
                                IconSize="14"
                                Width="28"
                                Height="28"
                                Padding="8"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </AutoCompleteBox.InnerRightContent>
                </AutoCompleteBox>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Static resources:Strings.Menu_RegionSelector_Region}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{Binding Regions}"
                        SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"
                        Width="200"
                        VerticalAlignment="Center" />
                    <Button
                        Command="{Binding SearchCommand}"
                        Content="{x:Static resources:Strings.Common_Search}"
                        Width="100"
                        VerticalAlignment="Center"
                        Classes="accent" />
                    <Button
                        Command="{Binding LoadMoreCommand}"
                        Content="{x:Static resources:Strings.Menu_RegionSelector_LoadMore}"
                        IsVisible="{Binding ShowLoadMoreButton}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer CornerRadius="8">
                <ItemsControl ItemsSource="{Binding Servers}" Padding="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ServerEntry">
                            <Border
                                Padding="16,8"
                                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding Region}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Static resources:Strings.ContextMenu_ServerInformation_Uptime}" />
                                            <Run Text="{Binding Uptime}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding JoinCommand}"
                                        Content="{x:Static resources:Strings.Menu_RegionSelector_Join}"
                                        Width="100"
                                        VerticalAlignment="Center"
                                        Classes="accent" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                IsVisible="{Binding IsServerListEmptyAndNotLoading}"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                CornerRadius="8"
                Opacity="0.8">
                <StackPanel
                    Spacing="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ic:Lucide
                        Icon="Search"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Opacity="0.5" />
                    <TextBlock
                        Text="{Binding ServerListMessage}"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border
                IsVisible="{Binding ShowLoadingIndicator}"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                CornerRadius="8"
                Opacity="0.8">
                <StackPanel
                    Spacing="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:FAProgressRing
                        IsIndeterminate="True"
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding LoadingMessage}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border
                IsVisible="{Binding IsLoadingMore}"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                CornerRadius="8"
                Opacity="0.8">
                <StackPanel
                    Spacing="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:FAProgressRing
                        IsIndeterminate="True"
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Static resources:Strings.Menu_RegionSelector_LoadingMore}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
