<UserControl
    x:Class="Froststrap.UI.Elements.Settings.Pages.BehaviourPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:gv="using:Froststrap.UI.ViewModels"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:lucideEnums="clr-namespace:LucideAvalonia.Enum;assembly=LucideAvalonia"
    d:DesignHeight="2500"
    d:DesignWidth="1200"
    x:DataType="vm:BehaviourViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="14,10">
            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}"
                Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
                <ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Behaviour_EnableVirtualDisplay_Title}"
                Description="{x:Static resources:Strings.Menu_Behaviour_EnableVirtualDisplay_Description}"
                IsExpanded="{Binding LaunchWithVirtualDisplay, Mode=TwoWay}"
                IsVisible="{x:Static gv:GlobalViewModel.IsMacOS}"
                Classes="NoUserExpansion">
                <controls:CardExpander.HeaderContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:Lucide
                            Icon="CircleAlert"
                            VerticalAlignment="Center"
                            StrokeBrush="Orange"
                            ToolTip.Tip="This feature is experimental and may not work as expected." />
                        <ToggleSwitch IsChecked="{Binding LaunchWithVirtualDisplay, Mode=TwoWay}" />
                    </StackPanel>
                </controls:CardExpander.HeaderContent>
                <StackPanel>
                    <controls:OptionControl
                        Header="Name"
                        Description="Customise the metadata what Virtual Display is recognized as">
                        <TextBox
                            Width="200"
                            PlaceholderText="Froststrap Virtual Display"
                            Text="{Binding VirtualDisplayName, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Width"
                        Description="Customise the screen width (scale is implied to 1 if set, and 0 is default)">
                        <TextBox
                            Width="200"
                            PlaceholderText="Froststrap Virtual Display"
                            Text="{Binding VirtualDisplayWidth, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Height"
                        Description="Customise the screen height (scale is implied to 1 if set, and 0 is default)">
                        <TextBox
                            Width="200"
                            PlaceholderText="Froststrap Virtual Display"
                            Text="{Binding VirtualDisplayHeight, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Behaviour_VirtualDisplayHz_Title}"
                        Description="{x:Static resources:Strings.Menu_Behaviour_VirtualDisplayHz_Description}">
                        <StackPanel MinWidth="260" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox
                                    Width="150"
                                    Height="32"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="{x:Static resources:Strings.Menu_Behaviour_VirtualDisplayHz_Placeholder}"
                                    Text="{Binding NewVirtualDisplayHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddVirtualDisplayHzCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button
                                    Height="32"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Static resources:Strings.Common_Add}"
                                    Command="{Binding AddVirtualDisplayHzCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding VirtualDisplayHzEntries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            MinHeight="40"
                                            Padding="8,4,4,4"
                                            CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding Display}"
                                                    VerticalAlignment="Center" />
                                                <controls:IconButton
                                                    Grid.Column="1"
                                                    Icon="Trash"
                                                    Command="{Binding RemoveCommand}"
                                                    Width="32"
                                                    Height="32"
                                                    MinHeight="32"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Classes="Danger"
                                                    ToolTip.Tip="{x:Static resources:Strings.Common_Remove}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:OptionControl>
                </StackPanel>
            </controls:CardExpander>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Title}"
                Description="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Description}"
                IsVisible="{x:Static gv:GlobalViewModel.IsWindows}">
                <ToggleSwitch IsChecked="{Binding CloseCrashHandler, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Title}"
                Description="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Description}"
                IsVisible="{x:Static gv:GlobalViewModel.IsWindows}">
                <ToggleSwitch IsChecked="{Binding BackgroundUpdates, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Behaviour_AllowCookieAccess_Title}"
                Description="{Binding Source={x:Static resources:Strings.Menu_Behaviour_AllowCookieAccess_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://docs.froststrap.xyz/docs/account-manager/account-access#what-froststrap-can-access'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:Lucide
                        Icon="TriangleAlert"
                        VerticalAlignment="Center"
                        StrokeBrush="Orange"
                        IsVisible="{Binding CookieLoadingFailed}" />
                    <ToggleSwitch IsChecked="{Binding CookieAccess, Mode=TwoWay}" />
                </StackPanel>
            </controls:OptionControl>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Bootstrapper_SoftKey_Title}"
                Description="{x:Static resources:Strings.Menu_Bootstrapper_SoftKey_Description}"
                IsExpanded="{Binding SoftKeyEnabled, Mode=OneWay}"
                IsVisible="{x:Static gv:GlobalViewModel.IsWindows}"
                Classes="NoUserExpansion">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding SoftKeyEnabled, Mode=TwoWay}" />
                </controls:CardExpander.HeaderContent>
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_SoftKeyProfile_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_SoftKeyProfile_Description}">
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{Binding SoftKeyProfiles}"
                        SelectedItem="{Binding SoftKeyProfile, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>
            </controls:CardExpander>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Bootstrapper_Experimental_BetterMatchmaking_Title}"
                Description="{x:Static resources:Strings.Menu_Bootstrapper_Experimental_BetterMatchmaking_Description}"
                IsExpanded="{Binding EnableBetterMatchmaking, Mode=OneWay}"
                Classes="NoUserExpansion">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding EnableBetterMatchmaking, Mode=TwoWay}" />
                </controls:CardExpander.HeaderContent>
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_PreferredRegion_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_PreferredRegion_Description}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ui:FAProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{Binding IsLoadingRegions}"
                            IsVisible="{Binding IsLoadingRegions}" />
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{Binding AvailableRegions}"
                            SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
            </controls:CardExpander>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Bootstrapper_AppStorage_Title}"
                Description="{x:Static resources:Strings.Menu_Bootstrapper_AppStorage_Description}"
                IsExpanded="True">
                <StackPanel>
                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_RobloxTheme_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_RobloxTheme_Description}">
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{Binding RobloxThemes}"
                            SelectedItem="{Binding RobloxTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding, Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_EnableRobloxBackgroundApp_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_EnableRobloxBackgroundApp_Description}">
                        <ToggleSwitch IsChecked="{Binding EnableRobloxBackgroundApp, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </controls:CardExpander>

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Title}"
                Description="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Description}"
                IsExpanded="True">
                <StackPanel>
                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Description}">
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{Binding CleanerOptions}"
                            SelectedItem="{Binding CleanerOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Description}">
                        <ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Description}">
                        <ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Description}">
                        <ToggleSwitch IsChecked="{Binding CleanerFroststrap, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </controls:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
