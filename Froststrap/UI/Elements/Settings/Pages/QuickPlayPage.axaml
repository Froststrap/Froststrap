<UserControl
    x:Class="Froststrap.UI.Elements.Settings.Pages.QuickPlayPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:models="clr-namespace:Froststrap.Models"
    xmlns:apis="clr-namespace:Froststrap.Models.APIs.Roblox"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:resources="clr-namespace:Froststrap.Resources"
    xmlns:utility="clr-namespace:Froststrap.UI.Utility"
    x:Name="RootPage"
    x:DataType="vm:QuickPlayViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="GameCardTemplate" x:DataType="models:QuickPlayGameItem">
            <Button
                Margin="4"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ClickMode="Press">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
                <Button.Flyout>
                    <MenuFlyout Placement="Pointer">
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_JoinGame}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).JoinGameCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Play" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_RejoinLastServer}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).RejoinLastServerCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="RotateCcwClock" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_JoinBestRegion}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).JoinBestRegionCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding DataContext.CanJoinBestRegion, ElementName=RootPage}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Globe" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="{Binding ServerCount, StringFormat='{x:Static resources:Strings.Menu_QuickPlay_TrackedServers}'}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).ViewServersCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Source, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Tracked}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="FileCode" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_RobloxServers}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).ViewRobloxServersCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Server" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_Reviews}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).ViewReviewsCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="MessageSquare" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_PrivateServers}"
                            Command="{Binding DataContext.ShowPrivateServersCommand, ElementName=RootPage}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding DataContext.HasActiveAccount, ElementName=RootPage}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="LockKeyholeOpen" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_ViewSubplaces}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).ViewSubplacesCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Layers" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="{x:Static resources:Strings.Menu_QuickPlay_VisitPage}"
                            Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).VisitPageCommand}"
                            CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="ExternalLink" Height="16" Width="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>

                <controls:Card
                    MaxWidth="190"
                    Padding="0"
                    CornerRadius="12,12,4,4"
                    ClipToBounds="True">
                    <Panel>
                        <StackPanel>
                            <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                <Image
                                    Source="{Binding ThumbnailBitmap}"
                                    Height="190"
                                    MinWidth="190"
                                    Stretch="Fill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <StackPanel Margin="8" Spacing="4">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        Text="{Binding Creator, StringFormat='By {0}'}"
                                        FontSize="11"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Image
                                        IsVisible="{Binding IsVerified}"
                                        Source="avares://Froststrap/Resources/RobloxVerified.png"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto,*">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:Lucide
                                            Icon="Users"
                                            Height="12"
                                            Width="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding Playing, Converter={StaticResource NumberAbbreviationConverter}}"
                                            FontSize="11"
                                            FontWeight="Medium" />
                                        <TextBlock
                                            Text="{x:Static resources:Strings.Menu_QuickPlay_Active}"
                                            FontSize="11"
                                            Opacity="0.5" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right">
                                        <ic:Lucide
                                            Icon="Eye"
                                            Height="12"
                                            Width="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding Visits, Converter={StaticResource NumberAbbreviationConverter}}"
                                            FontSize="11"
                                            FontWeight="Medium" />
                                        <TextBlock
                                            Text="{x:Static resources:Strings.Menu_QuickPlay_Visits}"
                                            FontSize="11"
                                            Opacity="0.5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            IsVisible="{Binding Source, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Tracked}"
                            Margin="8"
                            Padding="8,2"
                            Background="Black"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ic:Lucide Icon="Server" Height="12" Width="12" />
                                <TextBlock
                                    Text="{Binding ServerCount}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <Panel
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Border
                                IsVisible="{Binding Source, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Tracked}"
                                Padding="8,2"
                                Background="#22C55E"
                                CornerRadius="8">
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_Tracked}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </Border>
                            <Border
                                IsVisible="{Binding Source, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RobloxApi}"
                                Padding="8,2"
                                Background="#3B82F6"
                                CornerRadius="8">
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_RobloxAPI}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </Border>
                        </Panel>
                    </Panel>
                </controls:Card>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="14,10">
                <Border
                    Margin="0,0,0,16"
                    Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border
                            Grid.Column="0"
                            Width="190"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12,12,4,4"
                            ClipToBounds="True">
                            <Panel>
                                <StackPanel IsVisible="{Binding HasSelectedGame}">
                                    <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                        <Image
                                            Source="{Binding SelectedGame.ThumbnailBitmap}"
                                            Height="190"
                                            MinWidth="190"
                                            Stretch="Fill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    </Border>
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock
                                            Text="{Binding SelectedGame.Name}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                Text="{Binding SelectedGame.Creator, StringFormat='By {0}'}"
                                                FontSize="11"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <Image
                                                IsVisible="{Binding SelectedGame.IsVerified}"
                                                Source="avares://Froststrap/Resources/RobloxVerified.png"
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ic:Lucide
                                                    Icon="Users"
                                                    Height="12"
                                                    Width="12"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding SelectedGame.Playing, Converter={StaticResource NumberAbbreviationConverter}}"
                                                    FontSize="11"
                                                    FontWeight="Medium" />
                                                <TextBlock
                                                    Text="{x:Static resources:Strings.Menu_QuickPlay_Active}"
                                                    FontSize="11"
                                                    Opacity="0.5" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right">
                                                <ic:Lucide
                                                    Icon="Eye"
                                                    Height="12"
                                                    Width="12"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding SelectedGame.Visits, Converter={StaticResource NumberAbbreviationConverter}}"
                                                    FontSize="11"
                                                    FontWeight="Medium" />
                                                <TextBlock
                                                    Text="{x:Static resources:Strings.Menu_QuickPlay_Visits}"
                                                    FontSize="11"
                                                    Opacity="0.5" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding !HasSelectedGame}"
                                    Margin="16"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <ic:Lucide
                                        Icon="Gamepad2"
                                        Height="36"
                                        Width="36"
                                        Opacity="0.4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="Search up a game for info."
                                        FontSize="11"
                                        Opacity="0.6"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Panel>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Top">
                            <TextBlock
                                Text="Place ID"
                                FontSize="11"
                                Opacity="0.7"
                                Margin="4,0,0,0" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <AutoCompleteBox
                                    x:Name="GameSearchAutoCompleteBox"
                                    Grid.Column="0"
                                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                    ItemsSource="{Binding SearchResults}"
                                    IsDropDownOpen="{Binding IsSearchFlyoutOpen, Mode=TwoWay}"
                                    PlaceholderText="{x:Static resources:Strings.Menu_RegionSelector_FindGame}"
                                    FilterMode="None"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate DataType="apis:OmniSearchContent">
                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="8"
                                                MaxWidth="380">
                                                <Border
                                                    Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    Background="#10FFFFFF"
                                                    ClipToBounds="True"
                                                    CornerRadius="4">
                                                    <Image
                                                        Source="{Binding ThumbnailBitmap}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapInterpolationMode="LowQuality" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{Binding RootPlaceId, StringFormat='ID: {0}'}"
                                                        FontSize="11"
                                                        Opacity="0.5" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                                    <ic:Lucide
                                                        Icon="Users"
                                                        Height="12"
                                                        Width="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock
                                                        Text="{Binding PlayerCount, Converter={StaticResource NumberAbbreviationConverter}}"
                                                        FontSize="12"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>

                                    <AutoCompleteBox.InnerLeftContent>
                                        <ic:Lucide
                                            Icon="Search"
                                            Height="14"
                                            Width="14"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center" />
                                    </AutoCompleteBox.InnerLeftContent>

                                    <AutoCompleteBox.InnerRightContent>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ui:FAProgressRing
                                                IsVisible="{Binding IsGameSearchLoading}"
                                                IsIndeterminate="True"
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center" />
                                            <controls:IconButton
                                                Command="{Binding ClearSearchCommand}"
                                                IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                                Icon="X"
                                                IconSize="14"
                                                Width="28"
                                                Height="28"
                                                Padding="8"
                                                Margin="0,0,4,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </AutoCompleteBox.InnerRightContent>
                                </AutoCompleteBox>

                                <controls:IconButton
                                    Grid.Column="1"
                                    Command="{Binding ShowPrivateServersFromSearchCommand}"
                                    IsEnabled="{Binding HasCurrentSearchPlace}"
                                    Icon="Lock"
                                    IconSize="16"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static resources:Strings.Menu_QuickPlay_PrivateServers}" />
                            </Grid>

                            <TextBlock
                                Text="Server ID (Optional)"
                                FontSize="11"
                                Opacity="0.7"
                                Margin="4,4,0,0" />

                            <TextBox
                                Text="{Binding ServerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Enter Server ID"
                                HorizontalAlignment="Stretch" />

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="4"
                                Margin="0,4,0,0">
                                <controls:IconButton
                                    Grid.Column="0"
                                    Command="{Binding JoinServerByIdCommand}"
                                    Icon="Play"
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Classes="Primary" />
                                <controls:IconButton
                                    Grid.Column="1"
                                    Command="{Binding JoinBestRegionFromSearchCommand}"
                                    Icon="Earth"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Classes="Primary" />
                            </Grid>
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            MinWidth="240"
                            MaxWidth="320"
                            MaxHeight="265"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12,12,4,4"
                            ClipToBounds="True"
                            HorizontalAlignment="Left">
                            <Grid RowDefinitions="Auto,*">
                                <Border
                                    Grid.Row="0"
                                    Padding="16,8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <ic:Lucide
                                                Icon="Layers"
                                                Height="14"
                                                Width="14"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Static resources:Strings.Menu_QuickPlay_ViewSubplaces}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            IsVisible="{Binding HasSubplaces}"
                                            Padding="8,2"
                                            Background="{DynamicResource AccentButtonBackground}"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Subplaces.Count}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource AccentButtonForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Panel Grid.Row="1">
                                    <ScrollViewer
                                        IsVisible="{Binding HasSubplaces}"
                                        Padding="8"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Subplaces}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlaceInfo">
                                                    <Border
                                                        Padding="8"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        CornerRadius="8">
                                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="40"
                                                                Height="40"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                                <Image
                                                                    utility:RemoteImage.SourceUrl="{Binding ThumbnailUrl}"
                                                                    Stretch="UniformToFill"
                                                                    RenderOptions.BitmapInterpolationMode="LowQuality" />
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding Name}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding Name}" />
                                                            <controls:IconButton
                                                                Grid.Column="2"
                                                                Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).JoinSubplaceCommand}"
                                                                CommandParameter="{Binding}"
                                                                Icon="Play"
                                                                IconSize="12"
                                                                Width="30"
                                                                Height="30"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Classes="Primary"
                                                                ToolTip.Tip="{x:Static resources:Strings.Menu_QuickPlay_JoinGame}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel
                                        IsVisible="{Binding IsLoadingSubplaces}"
                                        Margin="16"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <ui:FAProgressRing
                                            IsActive="{Binding IsLoadingSubplaces}"
                                            Width="32"
                                            Height="32"
                                            Foreground="{DynamicResource SystemAccentColor}" />
                                        <TextBlock
                                            Text="{x:Static resources:Strings.Menu_QuickPlay_LoadingSubplaces}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel
                                        IsVisible="{Binding ShowSubplacesEmpty}"
                                        Margin="16"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <ic:Lucide
                                            Icon="Layers"
                                            Height="32"
                                            Width="32"
                                            Opacity="0.4"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            IsVisible="{Binding !HasCurrentSearchPlace}"
                                            Text="{x:Static resources:Strings.Menu_QuickPlay_NoSubplacesSelected}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            IsVisible="{Binding HasCurrentSearchPlace}"
                                            Text="{x:Static resources:Strings.Menu_QuickPlay_NoSubplacesFound}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Panel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="{x:Static resources:Strings.Menu_QuickPlay_ContinuePlaying}">
                        <ui:TabItemHelper.Icon>
                            <ic:Lucide Icon="RotateCcwClock" />
                        </ui:TabItemHelper.Icon>
                        <Grid ClipToBounds="True">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemsSource="{Binding RecentGames}"
                                    ItemTemplate="{StaticResource GameCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                IsVisible="{Binding ShowRecentEmpty}"
                                Text="{x:Static resources:Strings.Menu_QuickPlay_NoRecentGames}"
                                Opacity="0.6"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <StackPanel
                                IsVisible="{Binding IsLoading}"
                                Margin="0,16"
                                Spacing="16"
                                ZIndex="1"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_LoadingRecentGames}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Opacity="0.9"
                                    HorizontalAlignment="Center" />
                                <ui:FAProgressRing
                                    IsActive="{Binding IsLoading}"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource SystemAccentColor}" />
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_FetchingGameInfo}"
                                    FontSize="12"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{x:Static resources:Strings.Menu_QuickPlay_Recommended}">
                        <ui:TabItemHelper.Icon>
                            <ic:Lucide Icon="GamepadDirectional" />
                        </ui:TabItemHelper.Icon>
                        <Grid ClipToBounds="True">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemsSource="{Binding RecommendedGames}"
                                    ItemTemplate="{StaticResource GameCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel
                                IsVisible="{Binding ShowRecommendedEmpty}"
                                Spacing="8"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    IsVisible="{Binding IsLoggedIn}"
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_NoRecommendedGames}"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    IsVisible="{Binding !IsLoggedIn}"
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_LoginToSeeRecommended}"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel
                                IsVisible="{Binding IsRecommendedLoading}"
                                Margin="0,16"
                                Spacing="16"
                                ZIndex="1"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_LoadingRecommended}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Opacity="0.9"
                                    HorizontalAlignment="Center" />
                                <ui:FAProgressRing
                                    IsActive="{Binding IsRecommendedLoading}"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource SystemAccentColor}" />
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_FetchingGameInfo}"
                                    FontSize="12"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{x:Static resources:Strings.Menu_QuickPlay_Favorites}">
                        <ui:TabItemHelper.Icon>
                            <ic:Lucide Icon="Star" />
                        </ui:TabItemHelper.Icon>
                        <Grid ClipToBounds="True">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemsSource="{Binding FavoriteGames}"
                                    ItemTemplate="{StaticResource GameCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel
                                IsVisible="{Binding ShowFavoritesEmpty}"
                                Margin="0,16"
                                Spacing="16"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    IsVisible="{Binding IsLoggedIn}"
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_NoFavoriteGames}"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    IsVisible="{Binding !IsLoggedIn}"
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_LoginToSeeFavorites}"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel
                                IsVisible="{Binding IsFavoritesLoading}"
                                Margin="0,16"
                                Spacing="16"
                                ZIndex="1"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_LoadingFavorites}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Opacity="0.9"
                                    HorizontalAlignment="Center" />
                                <ui:FAProgressRing
                                    IsActive="{Binding IsFavoritesLoading}"
                                    Width="48"
                                    Height="48"
                                    Foreground="{DynamicResource SystemAccentColor}" />
                                <TextBlock
                                    Text="{x:Static resources:Strings.Menu_QuickPlay_FetchingGameInfo}"
                                    FontSize="12"
                                    Opacity="0.6"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <Grid
            IsVisible="{Binding IsJoiningBestRegion}"
            Background="#99000000"
            ZIndex="200">
            <StackPanel
                Spacing="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Static resources:Strings.Menu_QuickPlay_FindingBestServer}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Opacity="0.9"
                    HorizontalAlignment="Center" />
                <ui:FAProgressRing
                    IsActive="{Binding IsJoiningBestRegion}"
                    Width="48"
                    Height="48"
                    Foreground="{DynamicResource SystemAccentColor}" />
                <TextBlock
                    Text="{x:Static resources:Strings.Menu_QuickPlay_CheckingServers}"
                    FontSize="12"
                    Opacity="0.7"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
