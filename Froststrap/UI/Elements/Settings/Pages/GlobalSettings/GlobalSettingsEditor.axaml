<UserControl x:Class="Froststrap.UI.Elements.Settings.Pages.GlobalSettings.GlobalSettingsEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:model="using:Froststrap.Models"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:resources="using:Froststrap.Localisation"
             xmlns:local="using:Froststrap.UI.Elements.Settings.Pages.GlobalSettings"
             x:DataType="local:GlobalSettingsEditor">

    <Grid RowDefinitions="Auto,*" Margin="14">
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox Name="SearchTextBox"
                     VerticalContentAlignment="Center"
                     PlaceholderText="Search settings..."
                     TextChanged="SearchTextBox_TextChanged">
                <TextBox.InnerLeftContent>
                    <ic:Lucide Height="16" Width="16" Icon="Search" Margin="10,0,0,0" VerticalAlignment="Center" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <controls:AotDataGrid Grid.Row="1" Name="DataGrid" SelectionMode="Single">
            <controls:AotDataGrid.Columns>
                <controls:AotDataGridColumn Header="{x:Static resources:Strings.Common_Name}" Width="*">
                    <controls:AotDataGridColumn.CellTemplate>
                        <DataTemplate x:DataType="model:GlobalSetting">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </controls:AotDataGridColumn.CellTemplate>
                </controls:AotDataGridColumn>

                <controls:AotDataGridColumn Header="{x:Static resources:Strings.Common_Value}" Width="150">
                    <controls:AotDataGridColumn.CellTemplate>
                        <DataTemplate x:DataType="model:GlobalSetting">
                            <TextBox Text="{Binding Value}"
                                     IsEnabled="{Binding !IsVector}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     LostFocus="ValueTextBox_LostFocus"
                                     KeyDown="ValueTextBox_KeyDown" />
                        </DataTemplate>
                    </controls:AotDataGridColumn.CellTemplate>
                </controls:AotDataGridColumn>

                <controls:AotDataGridColumn Header="{x:Static resources:Strings.Menu_GBSEditor_VectorX}" Width="100">
                    <controls:AotDataGridColumn.CellTemplate>
                        <DataTemplate x:DataType="model:GlobalSetting">
                            <TextBox Text="{Binding VectorX}"
                                     IsEnabled="{Binding IsVector}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     LostFocus="VectorXTextBox_LostFocus"
                                     KeyDown="VectorXTextBox_KeyDown" />
                        </DataTemplate>
                    </controls:AotDataGridColumn.CellTemplate>
                </controls:AotDataGridColumn>

                <controls:AotDataGridColumn Header="{x:Static resources:Strings.Menu_GBSEditor_VectorY}" Width="100">
                    <controls:AotDataGridColumn.CellTemplate>
                        <DataTemplate x:DataType="model:GlobalSetting">
                            <TextBox Text="{Binding VectorY}"
                                     IsEnabled="{Binding IsVector}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     LostFocus="VectorYTextBox_LostFocus"
                                     KeyDown="VectorYTextBox_KeyDown" />
                        </DataTemplate>
                    </controls:AotDataGridColumn.CellTemplate>
                </controls:AotDataGridColumn>
            </controls:AotDataGrid.Columns>
        </controls:AotDataGrid>
    </Grid>
</UserControl>
