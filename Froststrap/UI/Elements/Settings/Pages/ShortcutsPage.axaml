<UserControl
    x:Class="Froststrap.UI.Elements.Settings.Pages.ShortcutsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:apis="clr-namespace:Froststrap.Models.APIs.Roblox"
    xmlns:gv="using:Froststrap.UI.ViewModels"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    x:DataType="vm:ShortcutsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="14,10">
            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Title}"
                Description="{Binding Source={x:Static resources:Strings.Menu_Shortcuts_ExtractIcons_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://bloxstraplabs.com/wiki/info/using-roblox-icons-for-shortcuts/'}"
                HelpLink="https://bloxstraplabs.com/wiki/info/using-roblox-icons-for-shortcuts/">
                <ToggleSwitch IsChecked="{Binding ExtractIconsTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:SectionHeader
                Title="{x:Static resources:Strings.Menu_Shortcuts_General_Title}"
                Description="{x:Static resources:Strings.Menu_Shortcuts_General_Description}"
                Margin="0,4,0,4" />

            <Grid
                x:Name="ShortcutsGrid"
                ColumnDefinitions="*,*"
                ColumnSpacing="4">
                <controls:OptionControl
                    x:Name="DesktopOption"
                    Grid.Column="0"
                    Header="{x:Static resources:Strings.Common_Shortcuts_Desktop}">
                    <ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    x:Name="StartMenuOption"
                    Grid.Column="1"
                    Header="{x:Static resources:Strings.Common_Shortcuts_StartMenu}"
                    IsVisible="{x:Static gv:GlobalViewModel.IsWindows}">
                    <ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </Grid>

            <controls:SectionHeader
                Title="{x:Static resources:Strings.Menu_Shortcuts_Function_Title}"
                Description="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <controls:OptionControl
                    Grid.Column="0"
                    Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}">
                    <ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Grid.Column="1"
                    Header="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}">
                    <ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl
                    Grid.Column="2"
                    Header="{x:Static resources:Strings.Menu_Title}">
                    <ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </Grid>

            <controls:SectionHeader
                Title="{x:Static resources:Strings.Common_Miscellaneous}"
                Description="{x:Static resources:Strings.Menu_Shortcuts_Misc_Description}" />

            <controls:CardExpander
                Header="{x:Static resources:Strings.Menu_Shortcuts_GameShortcut_Title}"
                IsExpanded="True">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            Width="100"
                            Height="100"
                            CornerRadius="12"
                            ClipToBounds="True"
                            Background="{DynamicResource ControlAltFillColorQuarternaryBrush}">
                            <Image
                                Source="{Binding PreviewIcon}"
                                Stretch="UniformToFill"
                                RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding PreviewName}"
                                FontSize="20"
                                FontWeight="Bold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding PreviewId}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <Label
                            Content="{x:Static resources:Strings.Menu_Shortcuts_SearchForGame}"
                            FontWeight="SemiBold" />

                        <AutoCompleteBox
                            x:Name="GameSearchAutoCompleteBox"
                            MinWidth="200"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding SearchResults}"
                            SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                            IsDropDownOpen="{Binding IsSearchFlyoutOpen, Mode=TwoWay}"
                            ui:AutoCompleteDropdownBehaviourAttacher.LoadMoreCommand="{Binding LoadMoreSearchResultsCommand}"
                            FilterMode="None"
                            PlaceholderText="{x:Static resources:Strings.Menu_RegionSelector_FindGame}">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate DataType="apis:OmniSearchContent">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border
                                            Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            Background="#10FFFFFF"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                            <Image
                                                Source="{Binding ThumbnailBitmap}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding RootPlaceId, StringFormat='ID: {0}'}"
                                                FontSize="11"
                                                Opacity="0.5" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                            <ic:Lucide
                                                Icon="Users"
                                                Width="12"
                                                Height="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{Binding PlayerCount, Converter={StaticResource NumberAbbreviationConverter}}"
                                                FontSize="12"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>

                            <AutoCompleteBox.InnerLeftContent>
                                <ic:Lucide
                                    Icon="Search"
                                    Width="14"
                                    Height="14"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />
                            </AutoCompleteBox.InnerLeftContent>

                            <AutoCompleteBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FAProgressRing
                                        Width="20"
                                        Height="20"
                                        IsIndeterminate="True"
                                        IsVisible="{Binding IsGameSearchLoading}"
                                        VerticalAlignment="Center" />
                                    <controls:IconButton
                                        Icon="X"
                                        IconSize="14"
                                        Width="28"
                                        Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </AutoCompleteBox.InnerRightContent>
                        </AutoCompleteBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <Label
                                Content="{x:Static resources:Strings.Menu_Shortcuts_ServerInstanceId}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox
                                Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="GUID/JobID" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <Label
                                Content="{x:Static resources:Strings.Menu_Shortcuts_PrivateAccessCode}"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox
                                Text="{Binding AccessCode, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Access Code" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <controls:IconButton
                            Icon="Plus"
                            Content="{x:Static resources:Strings.Menu_Shortcuts_CreateShortcut}"
                            Command="{Binding CreateGameShortcutCommand}" />
                        <TextBlock
                            Text="{Binding ShortcutStatus}"
                            FontSize="12"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </controls:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
