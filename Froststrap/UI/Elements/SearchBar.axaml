<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:models="using:Froststrap.Models"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:vm="clr-namespace:Froststrap.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Froststrap.UI.Elements.SearchBar"
             x:DataType="vm:SearchBarViewModel">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <AutoCompleteBox x:Name="SearchAutoCompleteBox"
                         Theme="{StaticResource SearchBarAutoCompleteBoxTheme}"
                         PlaceholderText="{x:Static resources:Strings.Menu_SearchBar_SearchSomething}"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ItemsSource="{Binding FilteredSearchResults}"
                         FilterMode="Contains"
                         MinimumPrefixLength="1"
                         MaxDropDownHeight="325"
                         IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay}"
                         VerticalAlignment="Center">
            <AutoCompleteBox.ItemTemplate>
                <DataTemplate DataType="models:SearchBarItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                        <ic:Lucide Grid.Column="0"
                                   Icon="{Binding IconSymbol, FallbackValue=Settings}"
                                   Height="20" Width="20"
                                   Opacity="0.8"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PageName}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </AutoCompleteBox.ItemTemplate>

            <AutoCompleteBox.InnerLeftContent>
                <controls:IconButton Command="{Binding ToggleSearchListCommand}"
                                     Icon="Search"
                                     IconSize="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Width="28"
                                     Height="28"
                                     VerticalAlignment="Center"
                                     Margin="2,0,0,0"
                                     Padding="8"/>
            </AutoCompleteBox.InnerLeftContent>

            <AutoCompleteBox.InnerRightContent>
                <controls:IconButton Command="{Binding ClearSearchCommand}"
                                     IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Icon="X"
                                     IconSize="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Width="28"
                                     Height="28"
                                     VerticalAlignment="Center"
                                     Margin="0,0,2,0"
                                     Padding="8"/>
            </AutoCompleteBox.InnerRightContent>
        </AutoCompleteBox>
    </Grid>
</UserControl>