<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:models="using:Froststrap.Models"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page4"
             x:DataType="vm:Page4ViewModel">

    <ScrollViewer>
        <StackPanel Margin="8">
            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                <ic:Lucide x:Name="HeaderIcon"
                           Icon="Earth"
                           Width="70"
                           Height="70"
                           HorizontalAlignment="Center"
                           StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}"
                           StrokeThickness="1.5">
                    <ic:Lucide.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut" />
                        </Transitions>
                    </ic:Lucide.Transitions>
                </ic:Lucide>
                <TextBlock Text="{x:Static resources:Strings.Menu_Bootstrapper_Experimental_BetterMatchmaking_Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static resources:Strings.Onboarding_Page4}"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

            <controls:CardExpander Header="{x:Static resources:Strings.Menu_Bootstrapper_Experimental_BetterMatchmaking_Title}"
                                   Description="{x:Static resources:Strings.Menu_Bootstrapper_Experimental_BetterMatchmaking_Description}"
                                   Classes="NoUserExpansion"
                                   IsExpanded="{Binding EnableBetterMatchmaking, Mode=OneWay}">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding EnableBetterMatchmaking, Mode=TwoWay}" />
                </controls:CardExpander.HeaderContent>
                <StackPanel>
                    <controls:OptionControl
                        Header="Sort Order"
                        Description="Select how to serve the servers, could affect how fast it takes to find a server.">
                        <ComboBox
                            MinWidth="200"
                            ItemsSource="{Binding SortOrderOptions}"
                            SelectedItem="{Binding SelectedSortOrderItem, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Content}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_PreferredRegion_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_PreferredRegion_Description}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <ui:FAProgressRing
                                IsActive="{Binding IsLoadingRegions}"
                                Width="20"
                                Height="20"
                                IsVisible="{Binding IsLoadingRegions}" />
                            <ComboBox
                                MinWidth="200"
                                ItemsSource="{Binding AvailableRegions}"
                                SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"
                                IsEnabled="{Binding IsRegionSelectionEnabled}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_MaxServerCheck_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_MaxServerCheck_Description}">
                        <TextBox
                            Width="200"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Text="{Binding MaxServerCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_BestRegionAmount_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_BestRegionAmount_Description}">
                        <TextBox
                            Width="200"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Text="{Binding BestRegionAmounts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:OptionControl>
                </StackPanel>
            </controls:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>