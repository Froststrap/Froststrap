<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:account="using:Froststrap.UI.Elements.Settings"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:gv="using:Froststrap.UI.ViewModels"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page5"
             x:DataType="vm:Page5ViewModel">

    <ScrollViewer>
        <StackPanel Margin="8">
            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                <ic:Lucide x:Name="HeaderIcon"
                           Icon="Link2"
                           Width="70"
                           Height="70"
                           HorizontalAlignment="Center"
                           StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}"
                           StrokeThickness="1.5">
                    <ic:Lucide.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut" />
                        </Transitions>
                    </ic:Lucide.Transitions>
                </ic:Lucide>
                <TextBlock Text="{x:Static resources:Strings.Common_Shortcuts}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Shortcuts_General_Description}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <Grid x:Name="ShortcutsGrid" ColumnDefinitions="*, *">
                    <controls:OptionControl
                        x:Name="DesktopOption"
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Header="{x:Static resources:Strings.Common_Shortcuts_Desktop}">
                        <ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        x:Name="StartMenuOption"
                        Grid.Column="1"
                        Margin="2,0,4,0"
                        IsVisible="{x:Static gv:GlobalViewModel.IsWindows}"
                        Header="{x:Static resources:Strings.Common_Shortcuts_StartMenu}">
                        <ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>
                </Grid>

                <Separator Margin="0,16,0,12" />

                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Shortcuts_Function_Description}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <Grid ColumnDefinitions="*,*,*">
                    <controls:OptionControl
                        Grid.Column="0"
                        Margin="0,0,2,0"
                        Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}">
                        <ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Grid.Column="1"
                        Margin="2,0,2,0"
                        Header="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}">
                        <ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Grid.Column="2"
                        Margin="2,0,2,0"
                        Header="{x:Static resources:Strings.Menu_Title}">
                        <ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
                    </controls:OptionControl>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>