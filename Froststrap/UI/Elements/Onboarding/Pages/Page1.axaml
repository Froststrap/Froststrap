<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:models="using:Froststrap.Models"
             xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
             xmlns:resources="using:Froststrap.Resources"
             xmlns:controls="using:Froststrap.UI.Elements.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page1"
             x:DataType="vm:Page1ViewModel">


    <ScrollViewer>
        <StackPanel Grid.Row="0" Margin="12">
            <TextBlock Text="{x:Static resources:Strings.Dialog_LanguageSelector_Header}"
                       FontSize="20" FontWeight="SemiBold" />

            <TextBlock Text="{x:Static resources:Strings.Dialog_LanguageSelector_Subtext}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <ComboBox ItemsSource="{Binding Languages, Mode=OneTime}" HorizontalAlignment="Stretch"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
