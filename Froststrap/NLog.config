<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target name="logfile" xsi:type="File"
            fileName="${specialfolder:folder=ApplicationData}/Froststrap/Logs/${date:format=yyyyMMdd'T'HHmmss'Z'}.log"
            layout="${longdate} ${level:uppercase=true} ${callsite:includeNamespace=false} - ${message} ${exception:format=tostring}"
            archiveAboveSize="1048576"
            maxArchiveFiles="15"
            concurrentWrites="true" />

    <target name="console" xsi:type="Console"
            layout="${longdate} ${level:uppercase=true} ${callsite:includeNamespace=false} - ${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="logfile,console" />
  </rules>
</nlog>
