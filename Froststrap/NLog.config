<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target name="latestfile" xsi:type="File"
            fileName="${gdc:item=logRoot}/latest.log"
            archiveOldFileOnStartup="true"
            archiveFileName="${gdc:item=logRoot}/${date:format=yyyy-MM-dd_HH-mm-ss}.log"
            maxArchiveFiles="29"
            layout="${date:format=HH\:mm\:ss} ${pad:padding=-5:inner=${level:uppercase=true}} ${callsite:includeNamespace=false} - ${message} ${exception:format=tostring}"
            deleteOldFileOnStartup="false"
    />

    <target name="console" xsi:type="ColoredConsole"
            layout="${date:format=HH\:mm\:ss} ${pad:padding=-5:inner=${level:uppercase=true}} ${callsite:includeNamespace=false} - ${message} ${exception:format=tostring}"
            useDefaultRowHighlightingRules="false"
    >
      <highlight-row condition="level == LogLevel.Trace" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Blue" />
      <highlight-row condition="level == LogLevel.Info" foregroundColor="Green" />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Yellow" backgroundColor="Red" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="latestfile,console" />
  </rules>
</nlog>