<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  	<AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
  	<InfAppVersion Condition="'$(InfAppVersion)' == ''">$(AppVersion)</InfAppVersion>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion)</FileVersion>
    <InformationalVersion>$(InfAppVersion)</InformationalVersion>
    <Company>Froststrap</Company>
    <Product>$(AssemblyName)</Product>
    <AssemblyName>Froststrap</AssemblyName>
    <RootNamespace>Froststrap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  	<PublishAot>true</PublishAot>
  	<PublishTrimmed>true</PublishTrimmed>
  	<TrimMode>full</TrimMode>
  	<NeutralLanguage>en</NeutralLanguage>
    <Description>Froststrap - A Fishstrap fork</Description>
    <ApplicationIcon>Froststrap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416;CA2007;CA1863;CA1031;CA1019;CA2000;CA1852;CA2216;CA1812;CA5392;SYSLIB1045;SYSLIB1054;CA5351;IL2104;CS7035</NoWarn>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS;_WIN32</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);__linux__</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('MacOS'))">$(DefineConstants);__APPLE__</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2070;IL2075</NoWarn>
    <DefineConstants>$(DefineConstants);FROSTSTRAP_AOT</DefineConstants>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <PropertyGroup>
    <AotEmbedNativeLibraries Condition="'$(AotEmbedNativeLibraries)' == ''">true</AotEmbedNativeLibraries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishAot)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRunComposite>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' != 'true'">true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <RootTrimmedAssemblies Condition="'$(RootTrimmedAssemblies)' == ''">true</RootTrimmedAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true' and '$(RootTrimmedAssemblies)' == 'true'">
    <TrimmerRootAssembly Include="Froststrap" />
    <TrimmerRootAssembly Include="AvaloniaEdit" />
    <TrimmerRootAssembly Include="ColorPicker" />
  </ItemGroup>

  <!-- Resources needed by Avalonia -->
  <ItemGroup>
    <AvaloniaResource Include="Resources/**" />
    <AvaloniaResource Include="UI/AppThemes/EditorThemes/*.xshd" />
    <AvaloniaResource Include="Froststrap.ico" />
    <AvaloniaResource Include="Froststrap.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Froststrap.ico" />
    <EmbeddedResource Include="Froststrap.png" />
    <EmbeddedResource Include="Resources\**\*.*" Exclude="Resources\**\*.resx" />
    <EmbeddedResource Include="NLog.config">
      <LogicalName>NLog.config</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DotMake.CommandLine" Version="3.7.0" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../libs/ColorPicker/ColorPicker.csproj" />
    <ProjectReference Include="../libs/LucideAvalonia/LucideAvalonia/LucideAvalonia.csproj" />
    <ProjectReference Include="../libs/FluentAvalonia/src/FluentAvalonia/FluentAvalonia.csproj" />
    <ProjectReference Include="../backend/backend.csproj" />
    <ProjectReference Include="../tools/JsonContextGen/JsonContextGen.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Froststrap.Models.Attributes.BuildMetadataAttribute">
      <_Parameter1>$([System.DateTime]::UtcNow.ToString("s"))Z</_Parameter1>
      <_Parameter2>$(COMPUTERNAME)/$(USERNAME)</_Parameter2>
      <_Parameter3>$(CommitHash)</_Parameter3>
      <_Parameter4>$(CommitRef)</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="CopyMacLibsFromBackend" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <PropertyGroup>
      <BackendOutDir>$(MSBuildProjectDirectory)/../backend/bin/$(Configuration)/$(TargetFramework)/</BackendOutDir>
    </PropertyGroup>

    <Copy SourceFiles="$(BackendOutDir)libvirtualdisplay.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libvirtualdisplay.dylib')" />

    <Copy SourceFiles="$(BackendOutDir)libmobileappreg.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libmobileappreg.dylib')" />

    <Copy SourceFiles="$(BackendOutDir)libnotify.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libnotify.dylib')" />
  </Target>

  <Target Name="KeepDylibsOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libnotify.dylib'&#xA;                                     Or '%(Filename)%(Extension)' == 'libvirtualdisplay.dylib'&#xA;                                     Or '%(Filename)%(Extension)' == 'libmobileappreg.dylib'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveJsonContextGenPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'JsonContextGen.deps.json'&#xA;                                     Or '%(Filename)%(Extension)' == 'JsonContextGen.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

  <Target Name="DeleteJsonContextGenPublishFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)JsonContextGen.deps.json;$(PublishDir)JsonContextGen.runtimeconfig.json" />
  </Target>

  <Target Name="EmbedAotNativeLibraries" BeforeTargets="_GenerateCompileInputs"
          Condition="'$(PublishAot)' == 'true' and '$(AotEmbedNativeLibraries)' == 'true' and ($([MSBuild]::IsOSPlatform('Windows')) or $([MSBuild]::IsOSPlatform('Linux')))">
    <PropertyGroup>
      <_AotNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_AotNativeRid>
      <_AotNativeRid Condition="'$(_AotNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_AotNativeRid>
      <_AotNotifyLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">notify.dll</_AotNotifyLib>
      <_AotNotifyLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">libnotify.so</_AotNotifyLib>
    </PropertyGroup>
    <ItemGroup>
      <_AotNativeLibrary Include="@(ReferenceCopyLocalPaths->Distinct())"
                         Condition="('%(Filename)%(Extension)' == 'av_libglesv2.dll'
                                    Or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll'
                                    Or '%(Filename)%(Extension)' == 'libSkiaSharp.dll'
                                    Or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.so'
                                    Or '%(Filename)%(Extension)' == 'libSkiaSharp.so')
                                    And $([System.String]::Copy('%(FullPath)').Contains('$(_AotNativeRid)'))" />
      <_AotNativeLibrary Include="$(MSBuildProjectDirectory)/../backend/bin/$(Configuration)/net10.0/$(_AotNotifyLib)"
                         Condition="Exists('$(MSBuildProjectDirectory)/../backend/bin/$(Configuration)/net10.0/$(_AotNotifyLib)')" />
      <EmbeddedResource Include="@(_AotNativeLibrary)">
        <LogicalName>Froststrap.Native.%(Filename)%(Extension)</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
    <GetFileHash Files="@(_AotNativeLibrary)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_AotNativeLibraryHashed" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)AotNative.manifest"
                      Lines="@(_AotNativeLibraryHashed->'%(Filename)%(Extension)|%(FileHash)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)AotNative.manifest">
        <LogicalName>Froststrap.Native.manifest</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CleanAotPublishOutput" AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_AotPublishKeep Include="$([MSBuild]::NormalizeDirectory('$(PublishDir)'))Froststrap.exe" />
      <_AotPublishKeep Include="$([MSBuild]::NormalizeDirectory('$(PublishDir)'))*.dll"
                       Condition="'$(AotEmbedNativeLibraries)' != 'true'" />
      <_AotPublishFiles Include="$([MSBuild]::NormalizeDirectory('$(PublishDir)'))**\*" Exclude="@(_AotPublishKeep)" />
      <_AotPublishDirectories Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
    </ItemGroup>
    <Delete Files="@(_AotPublishFiles)" ContinueOnError="true" />
    <RemoveDir Directories="@(_AotPublishDirectories)" ContinueOnError="true" />
  </Target>

  <Target Name="GenerateJsonContextRegistrations" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <JsonContextAutoGenerated>$(IntermediateOutputPath)JsonContext.AutoRegistered.g.cs</JsonContextAutoGenerated>
      <_JsonGenSources>$(IntermediateOutputPath)JsonContextGen.sources.rsp</_JsonGenSources>
      <_JsonGenReferences>$(IntermediateOutputPath)JsonContextGen.references.rsp</_JsonGenReferences>
    </PropertyGroup>
    <ItemGroup>
      <_JsonGenSource Include="@(Compile)" Exclude="$(JsonContextAutoGenerated)" />
      <_JsonGenReference Include="@(ReferencePath)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_JsonGenSources)" Lines="@(_JsonGenSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_JsonGenReferences)" Lines="@(_JsonGenReference->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../tools/JsonContextGen/JsonContextGen.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_JsonGenAssembly" />
    </MSBuild>
    <Exec Command="dotnet &quot;@(_JsonGenAssembly)&quot; &quot;$(_JsonGenSources)&quot; &quot;$(_JsonGenReferences)&quot; &quot;$(JsonContextAutoGenerated)&quot; &quot;$(DefineConstants)&quot;"
          Condition="'@(_JsonGenAssembly)' != ''"
          ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <Compile Remove="$(JsonContextAutoGenerated)" />
      <Compile Include="$(JsonContextAutoGenerated)" Condition="Exists('$(JsonContextAutoGenerated)')" />
    </ItemGroup>
  </Target>
</Project>