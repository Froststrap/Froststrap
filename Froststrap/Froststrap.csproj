<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  	<AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
  	<InfAppVersion Condition="'$(InfAppVersion)' == ''">$(AppVersion)</InfAppVersion>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion)</FileVersion>
    <InformationalVersion>$(InfAppVersion)</InformationalVersion>
    <AssemblyName>froststrap</AssemblyName>
    <Company>Froststrap</Company>
    <Product>Froststrap</Product>
    <RootNamespace>Froststrap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  	<PublishAot>true</PublishAot>
  	<PublishTrimmed>true</PublishTrimmed>
  	<TrimmerSingleWarn>false</TrimmerSingleWarn>
  	<TrimMode>full</TrimMode>
  	<NeutralLanguage>en</NeutralLanguage>
    <Description>Froststrap - A Fishstrap fork</Description>
    <ApplicationIcon>../build/win.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
    <StackTraceSupport>true</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <NoWarn>$(NoWarn);CA1852;CA1812;CA1863;CA2007;CA1031;CA2000;CA1416;CA5392;CS7035</NoWarn>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);_WIN32</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);__linux__</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('MacOS'))">$(DefineConstants);__APPLE__</DefineConstants>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <EnableHWIntrinsic>false</EnableHWIntrinsic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishAot)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(PublishAot)' != 'true'">true</PublishReadyToRunComposite>
    <EnableCompressionInSingleFile Condition="'$(PublishAot)' != 'true'">true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Resources needed by Avalonia -->
  <ItemGroup>
    <AvaloniaResource Include="Resources/**" />
    <AvaloniaResource Remove="Resources/Translations/Strings*.resx" />
    <AvaloniaResource Remove="Resources/Translations/Strings.Designer.cs" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DotMake.CommandLine" Version="3.7.0" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- 10.0.14 at least (NU1903); newer SDKs bring a newer one that must match their runtime pack -->
  <ItemGroup Condition="$([MSBuild]::VersionLessThan('$(BundledNETCoreAppPackageVersion)', '10.0.14'))">
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../libs/LucideAvalonia/LucideAvalonia/LucideAvalonia.csproj" />
    <ProjectReference Include="../libs/FluentAvalonia/src/FluentAvalonia/FluentAvalonia.csproj" />
    <ProjectReference Include="../libs/DiscordRPC-NativeAOT/DiscordRPC-NativeAOT.csproj" />
    <ProjectReference Include="../backend/backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Froststrap.Models.Attributes.BuildMetadataAttribute">
      <_Parameter1>$([System.DateTime]::UtcNow.ToString("s"))Z</_Parameter1>
      <_Parameter2>$(COMPUTERNAME)/$(USERNAME)</_Parameter2>
      <_Parameter3>$(CommitHash)</_Parameter3>
      <_Parameter4>$(CommitRef)</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Translations/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Froststrap.Resources</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources/Translations/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Import Project="Backend.targets" />
  <Import Project="JsonContextGeneration.targets" />
</Project>
