<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0</FileVersion>
    <Company>Froststrap</Company>
    <Product>$(AssemblyName)</Product>
    <AssemblyName>Froststrap</AssemblyName>
    <RootNamespace>Froststrap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<NeutralLanguage>en</NeutralLanguage>
    <Description>Froststrap - A Fishstrap fork</Description>
    <ApplicationIcon>Froststrap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416;CA2007;CA1863;CA1031;CA1019;SYSLIB1045;CA2000;CA1852;CA2216;CA1812</NoWarn>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Resources needed by Avalonia -->
  <ItemGroup>
    <AvaloniaResource Include="Resources/**" />
    <AvaloniaResource Include="UI/AppThemes/EditorThemes/*.xshd" />
    <AvaloniaResource Include="Froststrap.ico" />
    <AvaloniaResource Include="Froststrap.png" />
    <AvaloniaResource Include="FroststrapTray.ico" />
    <AvaloniaResource Include="UI\Elements\Base\BackgroundPanel.axaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Froststrap.ico" />
    <EmbeddedResource Include="Froststrap.png" />
    <EmbeddedResource Include="FroststrapTray.ico" />
    <EmbeddedResource Include="Resources\**\*.*" Exclude="Resources\**\*.resx" />
    <EmbeddedResource Include="NLog.config">
      <LogicalName>NLog.config</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <!--<PackageReference Include="Avalonia.Wayland" Version="12.0.5" />-->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="PuppeteerSharp" Version="24.42.0" />
    <PackageReference Include="PuppeteerExtraSharp" Version="3.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ColorPicker/ColorPicker.AvaloniaUI/ColorPicker.AvaloniaUI.csproj" />
    <ProjectReference Include="../LucideAvalonia/LucideAvalonia/LucideAvalonia.csproj" />
    <ProjectReference Include="../FluentAvalonia/src/FluentAvalonia/FluentAvalonia.csproj" />
    <ProjectReference Include="../backend/backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Froststrap.Models.Attributes.BuildMetadataAttribute">
      <_Parameter1>$([System.DateTime]::UtcNow.ToString("s"))Z</_Parameter1>
      <_Parameter2>$(COMPUTERNAME)/$(USERNAME)</_Parameter2>
      <_Parameter3>$(CommitHash)</_Parameter3>
      <_Parameter4>$(CommitRef)</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target
    Name="BuildVirtualDisplayDylib"
    BeforeTargets="BeforeBuild"
    Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="sh output_dylib.sh"
          WorkingDirectory="$(MSBuildProjectDirectory)/../macApp/virtualdisplay" />
    <PropertyGroup>
      <VirtualDisplayBuildDir Condition="Exists('$(MSBuildProjectDirectory)/../macApp/virtualdisplay/.build/out')">out</VirtualDisplayBuildDir>
      <VirtualDisplayBuildDir Condition="Exists('$(MSBuildProjectDirectory)/../macApp/virtualdisplay/.build/apple')">apple</VirtualDisplayBuildDir>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)/../macApp/virtualdisplay/.build/$(VirtualDisplayBuildDir)/Products/Release/libvirtualdisplay.dylib">
        <Link>libvirtualdisplay.dylib</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>
</Project>
