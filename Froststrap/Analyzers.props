<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1852;CA1812;CA1863;CA2007;CA1031;CA2000;CA1416;CA5392;CS7035</NoWarn>
  </PropertyGroup>
</Project>
