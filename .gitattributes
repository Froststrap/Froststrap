# Normalize line endings: LF in the repo, LF in working trees on every OS
* text=auto eol=lf

# Binary files: never touch line endings, never try to diff or merge
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.nupkg binary
