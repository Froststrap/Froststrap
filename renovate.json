{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "git-submodules",
    "github-actions",
    "nuget",
    "cargo"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "schedule": [
    "at any time"
  ],
  "timezone": "Australia/Sydney",
  "logLevel": "info"
}
