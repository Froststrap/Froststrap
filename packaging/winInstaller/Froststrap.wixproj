<Project Sdk="WixToolset.Sdk/5.0.0">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>Froststrap-Setup</OutputName>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\build</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);AppVersion=$(AppVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
  </ItemGroup>
</Project>
