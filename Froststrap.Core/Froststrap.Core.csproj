<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Froststrap/Analyzers.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Froststrap</RootNamespace>
    <AssemblyName>Froststrap.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CA1064</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="froststrap" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Froststrap.Localisation/Froststrap.Localisation.csproj" />
  </ItemGroup>
</Project>
