<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Froststrap/Analyzers.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Froststrap</RootNamespace>
    <AssemblyName>Froststrap.Localisation</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Translations/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Froststrap.Localisation</CustomToolNamespace>
    </EmbeddedResource>
    <Compile Update="Resources/Translations/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
