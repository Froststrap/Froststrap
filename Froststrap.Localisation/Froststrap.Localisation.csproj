<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Froststrap/Analyzers.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Froststrap</RootNamespace>
    <AssemblyName>Froststrap.Localisation</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <StringsSource>$(MSBuildProjectDirectory)/Resources/Translations/en-US.json</StringsSource>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Translations/*.json" LogicalName="Froststrap.Localisation.Translations.%(Filename)%(Extension)" />
  </ItemGroup>

  <UsingTask TaskName="GenerateStrings" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
var pairs = Regex.Matches(File.ReadAllText(Source), "\"((?:[^\"\\\\]|\\\\.)*)\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"");
var sb = new StringBuilder();
sb.AppendLine("// <auto-generated>Generated from en-US.json by Froststrap.Localisation.csproj</auto-generated>");
sb.AppendLine("namespace Froststrap.Localisation");
sb.AppendLine("{");
sb.AppendLine("    public static class Strings");
sb.AppendLine("    {");
foreach (Match pair in pairs)
{
    string name = pair.Groups[1].Value;
    if (!Regex.IsMatch(name, "^[A-Za-z_][A-Za-z0-9_]*$"))
    {
        Log.LogError(Source + ": '" + name + "' is not a valid C# identifier");
        continue;
    }
    string summary = Regex.Unescape(pair.Groups[2].Value).Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\r", "").Replace("\n", " ");
    if (summary.Length > 120)
        summary = summary.Substring(0, 117) + "...";
    sb.AppendLine("        /// <summary>" + summary + "</summary>");
    sb.AppendLine("        public static string " + name + " => Localizer.Get(\"" + name + "\");");
}
sb.AppendLine("    }");
sb.AppendLine("}");
string text = sb.ToString();
if (!File.Exists(Output) || File.ReadAllText(Output) != text)
{
    Directory.CreateDirectory(Path.GetDirectoryName(Output));
    File.WriteAllText(Output, text);
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ResolveStringsPath">
    <PropertyGroup>
      <StringsGenerated>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Strings.g.cs</StringsGenerated>
    </PropertyGroup>
  </Target>

  <Target Name="GenerateStrings" DependsOnTargets="ResolveStringsPath" BeforeTargets="CoreCompile" Inputs="$(StringsSource);$(MSBuildProjectFile)" Outputs="$(StringsGenerated)">
    <GenerateStrings Source="$(StringsSource)" Output="$(StringsGenerated)" />
  </Target>

  <Target Name="IncludeGeneratedStrings" DependsOnTargets="GenerateStrings" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(StringsGenerated)" />
      <Compile Include="$(StringsGenerated)" />
      <FileWrites Include="$(StringsGenerated)" />
    </ItemGroup>
  </Target>
</Project>
